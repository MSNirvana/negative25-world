NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://negative25:negative25@localhost:5432/negative25
# Set to 1 after PostgreSQL is migrated; leave at 0 for the in-memory demo adapter.
N25_USE_DATABASE=1
POSTGRES_DB=negative25
POSTGRES_USER=negative25
POSTGRES_PASSWORD=negative25
REDIS_URL=redis://localhost:6379
# API publishes import jobs when enabled; run the worker with RUN_WORKER=1.
N25_IMPORT_QUEUE=1
N25_ELEVATION_API_URL=https://api.open-meteo.com/v1/elevation
RUN_WORKER=1
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=negative25
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
WEB_ORIGIN=http://localhost:5173
# Maximum request body accepted by the API, including local binary photo uploads.
MAX_UPLOAD_BYTES=104857600
VITE_API_BASE_URL=http://localhost:3000/api/v1
# AMap Web JS API 2.0. Keep the real values in the ignored root .env file.
# Restrict the key to n25.world/localhost in the AMap console and request world-map access if needed.
VITE_AMAP_KEY=replace-with-amap-web-key
VITE_AMAP_SECURITY_CODE=replace-with-amap-security-code
JWT_SECRET=replace-with-a-long-development-secret
JWT_REFRESH_SECRET=replace-with-a-long-development-refresh-secret
PRIMARY_WORKSPACE_SLUG=primary
MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
GEOCODER_URL=https://example.invalid/geocode
# Optional: set this when previews are served through a CDN or public bucket URL.
S3_PUBLIC_BASE_URL=http://localhost:9000/negative25
# Production canonical URL is https://n25.world/
