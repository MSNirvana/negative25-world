{
  "openapi": "3.0.3",
  "info": { "title": "negative25 API", "version": "1.0.0", "description": "Versioned photography archive API shared by Web and future iPhone clients." },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/health": { "get": { "summary": "Service health", "responses": { "200": { "description": "Healthy API" } } } },
    "/auth/login": { "post": { "summary": "Create a session", "responses": { "200": { "description": "Access and refresh tokens" }, "401": { "description": "Invalid credentials" } } } },
    "/auth/refresh": { "post": { "summary": "Rotate a refresh token", "responses": { "200": { "description": "Rotated session" } } } },
    "/auth/me": { "get": { "summary": "Current user", "responses": { "200": { "description": "User profile" } } } },
    "/workspaces": { "get": { "summary": "List workspaces available to the current user", "responses": { "200": { "description": "Workspace memberships" }, "401": { "description": "Authentication required" } } } },
    "/spaces/{slug}": { "get": { "summary": "Read a public space", "parameters": [{ "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Space" }, "404": { "description": "Not found" } } } },
    "/spaces/{slug}/photos": { "get": { "summary": "List published photos", "parameters": [{ "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "mode", "in": "query", "schema": { "type": "string", "enum": ["featured", "recent", "shuffle", "location", "nearby", "faraway"] } }, { "name": "location", "in": "query", "description": "Stable region ID or normalized location slug", "schema": { "type": "string" } }, { "name": "cursor", "in": "query", "schema": { "type": "string" } }, { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 24 } }], "responses": { "200": { "description": "Cursor-paginated photo list" } } } },
    "/spaces/{slug}/albums": { "get": { "summary": "List public albums", "parameters": [{ "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Published albums with covers" }, "401": { "description": "Authentication required for private spaces" } } } },
    "/spaces/{slug}/albums/{albumId}": { "get": { "summary": "Read a public album by ID", "parameters": [{ "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "albumId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Album and published photos" }, "404": { "description": "Not found" } } } },
    "/photos/{id}": { "get": { "summary": "Read one published photo", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Photo" }, "404": { "description": "Not found" } } } },
    "/imports": { "post": { "summary": "Create an import batch", "responses": { "200": { "description": "Import batch" } } } },
    "/spaces/{slug}/imports": { "post": { "summary": "Create an import batch in a space", "parameters": [{ "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Import batch" } } }, "get": { "summary": "List import history for a workspace", "parameters": [{ "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Recent import batches" }, "401": { "description": "Authentication required" }, "403": { "description": "Workspace access denied" } } } },
    "/imports/{id}/{action}": { "post": { "summary": "Advance or cancel an import batch", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "action", "in": "path", "required": true, "schema": { "type": "string", "enum": ["preview", "confirm", "cancel", "retry"] } }], "responses": { "200": { "description": "Import batch" } } } },
    "/imports/{id}/publish": { "post": { "summary": "Publish completed photos from an import batch", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Published photo count" }, "401": { "description": "Authentication required" }, "403": { "description": "Editor access required" }, "404": { "description": "Import batch not found" }, "409": { "description": "Batch has no completed photos" } } } },
    "/spaces/{slug}/imports/{id}/publish": { "post": { "summary": "Publish completed photos from an import batch in a space", "parameters": [{ "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Published photo count" }, "401": { "description": "Authentication required" }, "403": { "description": "Editor access required" }, "404": { "description": "Import batch not found" }, "409": { "description": "Batch has no completed photos" } } } },
    "/media/upload-url": { "post": { "summary": "Create a private upload URL", "responses": { "200": { "description": "Signed upload URL" } } } },
    "/media/complete": { "post": { "summary": "Complete an upload", "responses": { "200": { "description": "Import item" } } } },
    "/admin/spaces/{slug}/summary": { "get": { "summary": "Read Studio summary for a workspace", "parameters": [{ "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Photo counts and recent import activity" }, "401": { "description": "Authentication required" }, "403": { "description": "Workspace access denied" } } } },
    "/admin/spaces/{slug}/photos": { "get": { "summary": "List workspace photos for Studio", "parameters": [{ "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Workspace photo list" } } } },
    "/admin/spaces/{slug}/photos/{id}": { "patch": { "summary": "Update photo visibility and metadata", "parameters": [{ "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Updated photo" } } } },
    "/admin/spaces/{slug}/albums": { "get": { "summary": "List workspace albums", "responses": { "200": { "description": "Albums with photo assignments and shoot dates" } } }, "post": { "summary": "Create an album", "responses": { "200": { "description": "Created album" } } } },
    "/admin/spaces/{slug}/albums/{id}": { "patch": { "summary": "Update an album, shoot date, and photo assignments", "responses": { "200": { "description": "Updated album" }, "404": { "description": "Not found" } } }, "delete": { "summary": "Delete an album", "responses": { "204": { "description": "Deleted" }, "404": { "description": "Not found" } } } },
    "/admin/spaces/{slug}/members": { "get": { "summary": "List workspace members", "parameters": [{ "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Workspace members" }, "403": { "description": "Insufficient workspace role" } } } },
    "/admin/spaces/{slug}/members/{userId}": { "patch": { "summary": "Update a workspace member role", "parameters": [{ "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Updated member" }, "403": { "description": "Insufficient role" }, "409": { "description": "Role change not allowed" } } } },
    "/discover/locations": { "get": { "summary": "List archive locations", "responses": { "200": { "description": "Locations" } } } },
    "/discover/nearby": { "get": { "summary": "Find nearby locations", "responses": { "200": { "description": "Distance ordered locations" } } } }
  }
}
