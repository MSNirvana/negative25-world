{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": { "AWS": ["*"] },
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::negative25/workspaces/*/photos/*/thumbnail.jpg",
        "arn:aws:s3:::negative25/workspaces/*/photos/*/preview.jpg",
        "arn:aws:s3:::negative25/workspaces/*/photos/*/large.jpg"
      ]
    }
  ]
}
